# Copy to .env (never commit .env). Generate secrets with: openssl rand -hex 32
JWT_SECRET=
# Shared by api-gateway, customer-backend and order-backend: the services only trust the gateway's identity headers when this comes with them.
GATEWAY_SHARED_SECRET=
OPENROUTER_API_KEY=
AUTH_DB_PASSWORD=postgres
APP_DB_PASSWORD=postgres123
GRAFANA_ADMIN_PASSWORD=admin

# Optional: URL of an n8n chat webhook for the AI agent UI on :3001 (a webhook URL is a credential)
N8N_WEBHOOK_URL=
# Optional: sent as X-Webhook-Secret; give the n8n webhook node Header Auth with the same value
N8N_WEBHOOK_SECRET=
